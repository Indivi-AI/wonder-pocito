{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "platform": {"enum": ["", "kubernetes", "openshift"]},
    "replicas": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767}
      }
    }
  }
}
