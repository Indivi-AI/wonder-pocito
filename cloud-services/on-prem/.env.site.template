# Single source of site config. Copy to .env.site NEXT TO docker-compose.yml, fill, never commit (.gitignored).
#   teammates:   ./wonder-up.sh --env <this file>   (repo root; auto-fills IMAGE_TAG and SITE_HOST, builds, starts, checks)
#   site:        docker compose --env-file .env.site up -d
#   outside sim: docker compose --env-file .env.site -f docker-compose.yml -f compose.airgap.yml --profile local-minio up -d
# Every call crosses the host at SITE_HOST:<published port> - browsers and services alike use the same URLs.
# NOTE keep comments of EMPTY values on their own line: some docker compose env parsers read "KEY=   # x" as value "# x".

# auto-filled by wonder-up.sh; manual: the build-images.sh output, e.g. 23-08-2026-14-30-a5e6314
IMAGE_TAG=
SITE_SCHEME=http
# auto-filled by wonder-up.sh (this machine's hostname); manual: the name browsers use - not localhost
SITE_HOST=
WONDER_PORT=8045                  # in-container listen ports
MARKETPLACE_PORT=8046             # marketplace = resource CRUD; agno = the AgentOS agent-run server
AGENT_OS_PORT=8047
WONDER_PUBLISHED_PORT=58045       # host-published ports everything talks through
MARKETPLACE_PUBLISHED_PORT=58046
LLM_LITE_PUBLISHED_PORT=58047
MINIO_PUBLISHED_PORT=58048
AGNO_PUBLISHED_PORT=58049
PGVECTOR_PUBLISHED_PORT=58050

# ON-PREM: the site's global MinIO URL (browser-reachable) - the compose runs no minio there.
# Leave empty ONLY in the outside sim: --profile local-minio then provides a stand-in at SITE_HOST:MINIO_PUBLISHED_PORT.
MINIO_ENDPOINT=
S3_ACCESS_KEY=wonder
S3_SECRET_KEY=wonder-minio-local
MARKETPLACE_S3_BUCKET=wonder-marketplace
# WARNING: MinIO rejects STANDARD_IA (InvalidStorageClass) - leave empty for MinIO
MARKETPLACE_S3_STORAGE_CLASS=

OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
LLM_MODEL=openai/gpt-5-mini       # wonder workflow model, provider/model form; the model part must exist behind llm-lite
# marketplace_e2e_model:model_factory = deterministic agent runs, no LLM needed
MARKETPLACE_MODEL_FACTORY=
# sim: minio-init creates them with anonymous rw; site: the global MinIO admin pre-creates them
WONDER_BUCKETS=indiviai-wonder,wonder-code-packages,indiviai-wonder-protected,logs-bucket-me-west1
# llm-lite master key - invent one per site; gates the published llm-lite port
LLM_PROXY_KEY=
# optional distinct MCP secret; when empty the deployment reuses LLM_PROXY_KEY
MCP_BEARER_TOKEN=
# OpenAI-compatible endpoint llm-lite routes to (sim: https://api.openai.com/v1; site: the internal endpoint)
LLM_UPSTREAM_BASE=
# key for that endpoint - never commit, never bake into an image
LLM_UPSTREAM_KEY=

POSTGRES_DB=wonder
POSTGRES_USER=wonder
POSTGRES_PASSWORD=wonder-pg-local
# Optional percent-encoded external SQLAlchemy URL; empty uses the local pgvector service.
PGVECTOR_URL=

MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
PGVECTOR_IMAGE=pgvector/pgvector:0.8.6-pg16-bookworm
LLM_LITE_IMAGE=ghcr.io/berriai/litellm:main-stable   # pin an exact tag before whitening
# empty = the committed passthrough config; site: ./llm-lite-site.yaml (your own LiteLLM yaml, next to this file).
# Any os.environ/KEY it references must be added to this .env.site.
# If it sets general_settings.master_key itself, LLM_PROXY_KEY here must equal it.
LLM_LITE_CONFIG=
