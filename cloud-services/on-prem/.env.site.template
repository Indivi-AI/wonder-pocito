# Single source of site config. Copy to .env.site NEXT TO docker-compose.yml, fill, never commit (.gitignored).
#   site:        docker compose --env-file .env.site --profile local-minio up -d
#   outside sim: docker compose --env-file .env.site -f docker-compose.yml -f compose.airgap.yml --profile local-minio up -d
# Every call crosses the host at SITE_HOST:<published port> - browsers and services alike use the same URLs.

IMAGE_TAG=                        # from build-images.sh output, e.g. 23-08-2026-14-30-a5e6314
SITE_SCHEME=http
SITE_HOST=                        # the name browsers use for this machine: its hostname, DNS name, or an /etc/hosts alias - not localhost
WONDER_PORT=8045                  # in-container listen ports
AGENT_OS_PORT=8046
WONDER_PUBLISHED_PORT=58045       # host-published ports everything talks through
MARKETPLACE_PUBLISHED_PORT=58046
LLM_LITE_PUBLISHED_PORT=58047
MINIO_PUBLISHED_PORT=58048

MINIO_ENDPOINT=                   # ON-PREM: the site's global MinIO URL (browser-reachable) - the compose runs no minio there.
                                  # Leave empty ONLY in the outside sim: --profile local-minio then provides a stand-in at SITE_HOST:MINIO_PUBLISHED_PORT.
S3_ACCESS_KEY=wonder
S3_SECRET_KEY=wonder-minio-local
MARKETPLACE_S3_BUCKET=wonder-marketplace
MARKETPLACE_S3_STORAGE_CLASS=     # WARNING: MinIO rejects STANDARD_IA (InvalidStorageClass) - leave empty for MinIO

OPENAI_MODEL=gpt-5-mini
LLM_MODEL=openai/gpt-5-mini       # wonder workflow model, provider/model form; the model part must exist behind llm-lite
MARKETPLACE_MODEL_FACTORY=        # marketplace_e2e_model:model_factory = deterministic agent runs, no LLM needed
WONDER_BUCKETS=indiviai-wonder,wonder-code-packages,indiviai-wonder-protected,logs-bucket-me-west1
                                  # sim: minio-init creates them with anonymous rw; site: the global MinIO admin pre-creates them
LLM_PROXY_KEY=                    # llm-lite master key - invent one per site; gates the published llm-lite port
LLM_UPSTREAM_BASE=                # OpenAI-compatible endpoint llm-lite routes to (sim: https://api.openai.com/v1; site: the internal endpoint)
LLM_UPSTREAM_KEY=                 # key for that endpoint - never commit, never bake into an image

MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
LLM_LITE_IMAGE=ghcr.io/berriai/litellm:main-stable   # pin an exact tag before whitening
