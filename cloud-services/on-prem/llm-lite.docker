FROM python:3.12-slim
RUN pip install --no-cache-dir litellm==1.98.0 fastapi==0.141.1 'uvicorn>=0.33,<1' pyyaml==6.0.3 python-multipart
RUN pip install --no-cache-dir 'websockets>=15,<16' backoff apscheduler orjson pyjwt rq hiredis cryptography pynacl uvloop \
  'expression>=5.6,<6' 'mcp>=1.28,<2' 'restrictedpython>=8.1,<9' 'fastapi-sso>=0.19,<1' 'rich>=13.9,<14' 'inquirerpy>=0.3,<1'
EXPOSE 4000
ENTRYPOINT ["litellm"]
