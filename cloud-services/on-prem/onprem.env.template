# Wonder on-prem configuration. Copy to onprem.env next to this file (or point ONPREM_ENV_FILE at it) and fill.
# Every on-prem script loads it automatically; variables already exported in the shell win over this file.

# ---------- required ----------
# image tag to push into the internal registry and run
WONDER_IMAGE=registry.client/wonder:VERSION
# MinIO S3 API endpoint reachable from the k8s pods and the publisher machine (NOT the :9001 console port)
MINIO_ENDPOINT=https://minio.internal.client
# MinIO S3 API endpoint reachable from user browsers
MINIO_PUBLIC_ENDPOINT=https://minio.client
# public Wonder origin - the ingress/route host you will expose for service wonder-public
WONDER_SERVICE_URL=https://wonder.client
# bucket-admin credentials, used only by deploy-buckets.sh to create buckets + anonymous policies (runtime is anonymous)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---------- optional ----------
# k8s namespace/project; default: current kube context
#NAMESPACE=wonder
# cluster cli; default: oc if present, else kubectl
#KUBE_CLI=oc
# docker or podman; default: docker
#CONTAINER_ENGINE=docker
# separate admin endpoint/credentials for bucket creation only; default: the MINIO_* values above
#MINIO_ADMIN_ENDPOINT=
#MINIO_ADMIN_ACCESS_KEY=
#MINIO_ADMIN_SECRET_KEY=
# default: us-east-1
#MINIO_REGION=
# what browsers use for storage urls; default: MINIO_PUBLIC_ENDPOINT
#WONDER_STORAGE_URL=
# where the applet runtime/cdn files are served from; default: MINIO_PUBLIC_ENDPOINT/wonder-code-packages/cdn
#WONDER_CDN_URL=
# path to extra KEY=VALUE lines merged into the pods secret (e.g. WONDER_TOKEN for the local user system)
#WONDER_ENV_FILE=
# MCP publisher port; default: 3000
#PORT=
# default: 5m
#ROLLOUT_TIMEOUT=
