# Wonder on-prem: single machine running the local server against MinIO.
# Copy to .env.onprem (same directory), fill MINIO_ENDPOINT, then: npm run onprem
# Loaded because npm run onprem sets WONDER_ENV=onprem (dev default loads .env.dev instead).

# MinIO S3 API endpoint, reachable from this machine and from user browsers (NOT the :9001 console)
MINIO_ENDPOINT=https://minio.internal
# leave as is: minio storage routing, anonymous public serving, server-side lambda calls back to this server
STORAGE_PROVIDER=minio
WONDER_AUTH_MODE=none
WONDER_SERVICE_URL=http://localhost:3000

# ---------- optional ----------
# storage endpoint for BROWSERS when different from MINIO_ENDPOINT
#WONDER_STORAGE_URL=
# runtime base for published-snapshot applet pages (live-repo serving does not need it)
#WONDER_CDN_URL=
# server port; default 3000
#PORT=
# marketplace (CRUD) URL as BROWSERS reach it; injected into applet pages as globalThis.MARKETPLACE_API_URL
# (default: the page's host on port 7777)
#MARKETPLACE_API_URL=
# agno (AgentOS agent-run) URL as BROWSERS reach it; injected into applet pages as globalThis.AGNO_API_URL
# (default: the page's host on port 7778)
#AGNO_API_URL=
