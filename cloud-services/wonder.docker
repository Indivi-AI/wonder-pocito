ARG BASE_IMAGE=me-west1-docker.pkg.dev/indiviai/cloud-run-source-deploy/node24-wonder-base:latest
FROM ${BASE_IMAGE}
ARG BUILD_TARGET=prod
ARG TARGETARCH
ARG INCLUDE_DUCKDB=true

# ---- Runtime utilities for lambdas/ETL (duckdb, jq, ...). Cached layer; add more tools here. ----
# httpfs + cache_httpfs baked in at build so cold containers never download them at query time (duckdb autoloads the pinned-version extensions).
# cache_httpfs caches fetched remote byte-ranges on local disk so repeat queries in a warm container skip the network.
RUN if [ "$INCLUDE_DUCKDB" = true ]; then \
 curl -fsSL https://github.com/duckdb/duckdb/releases/download/v1.5.4/duckdb_cli-linux-${TARGETARCH}.zip -o /tmp/d.zip \
 && unzip -d /usr/local/bin /tmp/d.zip && rm /tmp/d.zip \
 && duckdb -c "INSTALL httpfs; INSTALL cache_httpfs FROM community;"; fi

# ---- python3 + fastavro: the CDC avro readers. duckdb has no avro reader on every arch we build for, so
# avroCdcSource and buildCdcReference shell out to fastavro. Without this the schematics ETLs cannot run here. ----
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
 && pip3 install --no-cache-dir --break-system-packages fastavro google-cloud-storage \
 && rm -rf /var/lib/apt/lists/*

# ---- cols_cache: our prebuilt unsigned duckdb extension + its node colsCacheService. ----
COPY wonder/bi/cols-cache/cols_cache.duckdb_extension \
     wonder/bi/cols-cache/colsCacheService.js \
     wonder/bi/cols-cache/nodejs-importmap.js \
     ./wonder/bi/cols-cache/
ENV COLS_CACHE_EXT=/usr/src/app/wonder/bi/cols-cache/cols_cache.duckdb_extension \
    COLS_CACHE_LOADER=/usr/src/app/nodejs-importmap-loader.js

# ---- App layer (changes often) ----
COPY nodejs-importmap.js nodejs-importmap-loader.js ./
COPY jb6 ./jb6
COPY wonder ./wonder
COPY cloud-services ./cloud-services
COPY solutions ./solutions
RUN if [ "$BUILD_TARGET" != runtime ]; then cp "cloud-services/express-server/.env.${BUILD_TARGET}" .env \
 && grep -q WHAPI_TOKEN_WONDER_DEMO .env; fi

EXPOSE 8080
CMD [ "node", "--experimental-vm-modules", "--expose-gc", "--import", "./nodejs-importmap.js", "cloud-services/express-server/wonder-cloud-server.js" ]
