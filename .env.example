# Required external services. Model endpoints and keys belong in the file selected by LITELLM_CONFIG.
MINIO_ENDPOINT=http://localhost:9000
# Required for connected development; empty starts bundled PostgreSQL with local Agno inside the air-gapped dev image.
PGVECTOR_URL=postgresql+psycopg://wonder:wonder-pg-local@localhost:5432/wonder
# MINIO_ACCESS_KEY=wonder
# MINIO_SECRET_KEY=wonder-minio-local
# MARKETPLACE_S3_BUCKET=indiviai-wonder
S3_USE_PATH_STYLE=true

# Use STANDARD for stock MinIO, which does not support STANDARD_IA.
MINIO_STORAGE_CLASS=STANDARD_IA

# Required inside the air-gapped dev image. Leave empty in connected development to start the FLAPI mock.
FLAPI_BASE_URL=
FLAPI_TOKEN=
FLAPI_USERNAME=625navehp

# External LiteLLM. Leave empty to start the bundled LiteLLM.
LITELLM_HOST=
# Bundled LiteLLM config. Empty defaults to infra/dev/litellm/config.local.yaml in connected development; the air-gapped image must set it.
LITELLM_CONFIG=
# Optional gateway key used by OMP and Pocito when LiteLLM authentication is enabled.
LITELLM_API_KEY=

# External Agno. Leave empty to start the bundled Agno server.
AGNO_API_URL=

# Optional overrides; no Wonder env files are loaded.
# POCITO_PORT=3000
# MARKETPLACE_PORT=7777
# AGENT_OS_PORT=7778
# LITELLM_PORT=4000
# FLAPI_PORT=6001
# POCITO_DATA_DIR=.local-data
# OPENAI_EMBEDDING_DIMENSIONS=1536
