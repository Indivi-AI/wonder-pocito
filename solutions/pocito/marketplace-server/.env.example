OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# ---------- optional ----------
# bind addresses; 0.0.0.0 exposes a server beyond this machine (needed behind NAT/port-forwarding)
#MARKETPLACE_HOST=127.0.0.1
#MARKETPLACE_PORT=7777
#AGENT_OS_HOST=127.0.0.1
#AGENT_OS_PORT=7778
# extra browser origins, comma-separated, e.g. http://my-host:3000
#CORS_ALLOWED_ORIGINS=
# sent as StorageClass on every S3 put when set (e.g. STANDARD_IA); leave unset for MinIO
#MARKETPLACE_S3_STORAGE_CLASS=
