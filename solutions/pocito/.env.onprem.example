# Required external services. Model endpoints and keys belong in on-prem/litellm/config.local.yaml.
MINIO_ENDPOINT=http://localhost:9000
PGVECTOR_URL=postgresql+psycopg://wonder:wonder-pg-local@localhost:5432/wonder
# MINIO_ACCESS_KEY=wonder
# MINIO_SECRET_KEY=wonder-minio-local
# MARKETPLACE_S3_BUCKET=indiviai-wonder

# Use STANDARD for stock MinIO, which does not support STANDARD_IA.
MINIO_STORAGE_CLASS=STANDARD_IA

# External FLAPI. Leave empty to start the local mock.
FLAPI_BASE_URL=
FLAPI_TOKEN=
FLAPI_USERNAME=625navehp

# External LiteLLM. Leave empty to start the bundled LiteLLM.
LITELLM_HOST=

# External Agno. Leave empty to start the bundled Agno server.
AGNO_API_URL=

# Optional overrides; no Wonder env files are loaded.
# POCITO_PORT=3000
# MARKETPLACE_PORT=7777
# AGENT_OS_PORT=7778
# LITELLM_PORT=4000
# FLAPI_PORT=6001
# POCITO_DATA_DIR=.local-data
# OPENAI_EMBEDDING_DIMENSIONS=1536
