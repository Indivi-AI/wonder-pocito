# The values a human fills - everything else defaults inside docker-compose.yml (advanced overrides below).
# Copy to .env.site NEXT TO docker-compose.yml, never commit (.gitignored).
#   teammates:   ./wonder-up.sh --env <this file>   (repo root; auto-fills IMAGE_TAG and SITE_HOST, builds, starts, checks)
#   site:        docker compose --env-file .env.site up -d
#   outside sim: docker compose --env-file .env.site -f docker-compose.yml -f compose.airgap.yml --profile local-minio up -d

# auto-filled by wonder-up.sh; manual: the build-images.sh output, e.g. 23-08-2026-14-30-a5e6314
IMAGE_TAG=
# auto-filled by wonder-up.sh (this machine's hostname); manual: the name browsers use - not localhost
SITE_HOST=
# ON-PREM: the site's global MinIO URL (browser-reachable) + its credentials.
# Leave MINIO_ENDPOINT empty ONLY in the outside sim: --profile local-minio then provides a stand-in.
MINIO_ENDPOINT=
S3_ACCESS_KEY=wonder
S3_SECRET_KEY=wonder-minio-local
# Default model for applets/UI and sim-check.sh - a model llm-lite-config.yaml serves; the UI may pick another at runtime.
# The endpoint lives in llm-lite-config.yaml (copy its .template, gitignored); the key is typed HERE, on this machine only.
LLM_MODEL=openai/gpt-5-mini
LLM_API_KEY=
# The FLAPI package service (flow tools), e.g. http://flapi-host:6001 + its Bearer token. Leave empty when unused.
# Dev/sim: wonder-up.sh --flapi runs the vendored FLAPI mock and fills both values.
FLAPI_BASE_URL=
FLAPI_BEARER_TOKEN=

# ---------- advanced overrides (uncomment to change; defaults live in docker-compose.yml) ----------
