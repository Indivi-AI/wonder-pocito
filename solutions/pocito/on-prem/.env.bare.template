# Bare-process stack, no docker: node solutions/pocito/on-prem/bare-up.mjs - needs node+npm and python on PATH.
# Copy to .env.bare next to bare-up.mjs (gitignored). MinIO and postgres are NOT started here - point at
# reachable ones: the docker stack (:58048 / :58050), the site's global MinIO, or a local install.
MINIO_ENDPOINT=
S3_ACCESS_KEY=wonder
S3_SECRET_KEY=wonder-minio-local
# Default model for applets/UI - a model llm-lite-config.yaml serves; the key is typed HERE, on this machine only.
LLM_MODEL=openai/gpt-5-mini
LLM_API_KEY=

# ---------- advanced overrides (uncomment to change; defaults live in bare-up.mjs) ----------
#SITE_HOST=localhost
#WONDER_PORT=3000
#MARKETPLACE_PORT=7777
#AGENT_OS_PORT=7778
#LLM_LITE_PORT=4000
# percent-encoded external SQLAlchemy URL, or a reachable postgres+pgvector via host/port
#PGVECTOR_URL=
#PGVECTOR_HOST=localhost
#PGVECTOR_PORT=5432
#POSTGRES_DB=wonder
#POSTGRES_USER=wonder
#POSTGRES_PASSWORD=wonder-pg-local
#OPENAI_MODEL=gpt-5-mini
#FLAPI_BASE_URL=
#FLAPI_BEARER_TOKEN=
#PYTHON=python3.12
